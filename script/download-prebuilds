#!/usr/bin/env bash
# Collects the prebuilds that the Release workflow's prebuild jobs uploaded in this run, so the
# published package installs without a compiler. semantic-release runs it before publishing.

set -euo pipefail

cd "$(dirname "$0")/.."

rm -rf prebuilds
gh run download "$GITHUB_RUN_ID" --repo "$GITHUB_REPOSITORY" --pattern 'prebuilds-*' --dir prebuilds
# Each artifact downloads into a directory of its own; bindings/node loads prebuilds/<platform>-<arch>/.
for artifact in prebuilds/prebuilds-*/; do
  cp -R "$artifact". prebuilds/
  rm -rf "$artifact"
done

expected=4
actual=$(find prebuilds -name '*.node' | wc -l | tr -d ' ')
if [[ $actual -ne $expected ]]; then
  echo "Expected $expected prebuilds but found $actual" >&2
  exit 1
fi
