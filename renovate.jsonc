{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>WillBooster/willbooster-configs:renovate.jsonc"],
  "packageRules": [
    {
      // script/tree-sitter generates, builds, and tests the parser with the CLI of the runtime version pinned as
      // @willbooster/web-tree-sitter, so a runtime update also regenerates the parser.
      "matchPackageNames": ["@willbooster/web-tree-sitter"],
      "groupName": "tree-sitter",
    },
  ],
}
