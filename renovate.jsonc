{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>WillBooster/willbooster-configs:renovate.jsonc"],
  "packageRules": [
    {
      // script/tree-sitter generates, builds, and tests the parser with the CLI of the runtime version pinned as
      // @willbooster/web-tree-sitter, so a runtime update needs a regenerated parser and usually a release whose type
      // matches the runtime's change. Renovate's automerge would squash such a fixed branch under its own `chore(deps)`
      // message, which semantic-release does not release.
      "matchPackageNames": ["@willbooster/web-tree-sitter"],
      "groupName": "tree-sitter",
      "automerge": false,
    },
    // 19.1.0: Version 19 removes Query, which test/unit/joinedTimingSubstitutions.test.ts imports and uses; adopting it requires changing the test. https://github.com/WillBooster/tree-sitter/pull/350
    {
      "matchPackageNames": ["@willbooster/web-tree-sitter"],
      "allowedVersions": "!/^19\\.1\\.0$/",
    },
  ],
}
