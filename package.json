{
  "name": "@willbooster/tree-sitter-bash",
  "version": "0.25.1",
  "description": "Bash grammar for tree-sitter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/tree-sitter-bash.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "author": {
    "name": "Max Brunsfeld",
    "email": "maxbrunsfeld@gmail.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "bash"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.2.1",
    "node-gyp-build": "^4.8.2"
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@willbooster/wb": "22.7.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "^9.12.0",
    "eslint-config-treesitter": "^1.0.2",
    "node-gyp": "13.0.2",
    "prebuildify": "^6.0.1",
    "semantic-release": "25.0.5",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.27.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "patchedDependencies": {
    "eslint-config-treesitter@1.0.2": "patches/eslint-config-treesitter@1.0.2.patch"
  },
  "trustedDependencies": [
    "tree-sitter",
    "tree-sitter-cli"
  ],
  "scripts": {
    "install": "node-gyp-build",
    "lint": "eslint grammar.js",
    "prestart": "tree-sitter build --wasm",
    "release": "wb release",
    "release-test": "node node_modules/semantic-release/bin/semantic-release.js --dry-run --plugins @semantic-release/commit-analyzer @semantic-release/release-notes-generator",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "build-prebuilds": "prebuildify --napi --strip --name tree-sitter-bash",
    "build/ci": "tree-sitter generate"
  }
}
